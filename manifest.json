{
  "name": "SymphonyBoard",
  "url": "https://openspineconsortium.com/symphony/",
  "description": "Symphony: pull-request-gated Claude Code agents for your repository. Install it, press Create on the form, merge the pull request.",
  "hook_attributes": {
    "url": "https://example.invalid/webhook",
    "active": false
  },
  "redirect_url": "http://localhost:3010/registered",
  "public": false,
  "default_permissions": {
    "contents": "write",
    "issues": "write",
    "pull_requests": "write",
    "checks": "write",
    "workflows": "write",
    "actions": "write",
    "administration": "write",
    "pages": "write",
    "secrets": "write",
    "actions_variables": "write",
    "metadata": "read",
    "organization_administration": "write",
    "organization_secrets": "write",
    "organization_actions_variables": "write"
  },
  "default_events": [
    "issues",
    "issue_comment",
    "pull_request",
    "push",
    "check_suite"
  ]
}
